{"id": "nlv_001", "filename": "images/nlv_001.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se ichpochtli ika xonbelo tlachixtok ik tlani, kanin ixtlauak. Tlachipajtok."}
{"id": "nlv_002", "filename": "images/nlv_002.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se telpochtli moseuijtok ipan se ueyi tetl. Motlakentok ika xonbelo, tliliuik kamisa uan pantalon. Itech ima se tlakotl. Ikuitlapan kajki tepeyo."}
{"id": "nlv_003", "filename": "images/nlv_003.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Sekimej nauatekaj kikajtokej se tlapoualistli ika intlajtolkopa."}
{"id": "nlv_004", "filename": "images/nlv_004.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Ome telpochmej kimokixtiliaj se foto. Motlakentijtokej ika sejse ialtepetlaken."}
{"id": "nlv_005", "filename": "images/nlv_005.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Sekimej maseualmej non chantij ik Zongolica tlejkoskej ipan kamion."}
{"id": "nlv_006", "filename": "images/nlv_006.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Eyi siuamej motlapouiaj. Ome motlakentokej ken non chantij Ixhuatlancillo."}
{"id": "nlv_007", "filename": "images/nlv_007.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se ouamila ika itlatsakuil. Sekitsin tlamixtemik."}
{"id": "nlv_008", "filename": "images/nlv_008.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Ikaj kipixtok ima se palankatsin non nesi omotlajtlachialti."}
{"id": "nlv_009", "filename": "images/nlv_009.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Seki Yolitisxochitl uan se ajyoxiuitl."}
{"id": "nlv_010", "filename": "images/nlv_010.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Seki uajxilxochitl tlen yikin kueponij."}
{"id": "nlv_011", "filename": "images/nlv_011.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se gladiolajxochitl non achtsin youakik."}
{"id": "nlv_012", "filename": "images/nlv_012.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se kualtsin senpoalxochitl non melajka xochitl."}
{"id": "nlv_013", "filename": "images/nlv_013.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se foto kanin nextok ojtli, tetlala inakastlan uan semi tlamixtentok ken yetoskia totoka tiuaij ipan se karro."}
{"id": "nlv_014", "filename": "images/nlv_014.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se kiniaxiuitl non amo tikkuaj tlaxochixtok."}
{"id": "nlv_015", "filename": "images/nlv_015.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se kiniaxochitl ika se tokatl ipan. Nin kiniatl amo tikkuaj."}
{"id": "nlv_016", "filename": "images/nlv_016.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se ixtlauaktsintli ika kuajyo uan se kaltsintli. Uejka kajki se tiltepetl itoka Poyaujtekatl."}
{"id": "nlv_017", "filename": "images/nlv_017.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Tlakamej uan siuamej mopaleuiaj tlakualchiuaj. Se kitejteki xonakatl, okse kichiua tsopelikatl, okse kitejteki tsilanko, uan okome kichiua chilmoli."}
{"id": "nlv_018", "filename": "images/nlv_018.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Ijtik se kaltsintli, se ichpoka non tlakentok ika xochitlakemitl kitejteki nakatl ipan se tlapechtli."}
{"id": "nlv_019", "filename": "images/nlv_019.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se xonokuauitl ika xonokuilmej."}
{"id": "nlv_020", "filename": "images/nlv_020.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Ueyi tepeyo tlen amo niman tlami, nesi ik nouian kajki. Tlamixtentok uan san ik toyekma, ajkopa, tlachipauak."}
{"id": "nlv_021", "filename": "images/nlv_021.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se siuatsintli nemi ipan se teyo ojtli kanin kuajyo."}
{"id": "nlv_023", "filename": "images/nlv_023.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se tepetsintli kiyaualojtok kuautitlamitl uan semi tlamixtentok."}
{"id": "nlv_024", "filename": "images/nlv_024.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Itech se mantajkaltsintli kintetliokolilia tlakuali akinmej uejka uitsej. Nochtin motlakentiaj ika inmialtepetsotsol."}
{"id": "nlv_025", "filename": "images/nlv_025.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se ixtlauak ika miakej kaltsitsintin, kiyaualojtok tepeyo uan mixtli."}
{"id": "nlv_026", "filename": "images/nlv_026.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se kostik senpoalxochitl."}
{"id": "nlv_027", "filename": "images/nlv_027.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se matlalxochitl kualtsin uan se non yopitsuakik."}
{"id": "nlv_028", "filename": "images/nlv_028.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se ameyali uetsi ipan temej ijtik tepetl."}
{"id": "nlv_029", "filename": "images/nlv_029.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Seki tlalkamojtli uan se motasneki ken se \"yolotl\"."}
{"id": "nlv_030", "filename": "images/nlv_030.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se ueyatsintli ika temej tlen ipan tlapajpakaj."}
{"id": "nlv_031", "filename": "images/nlv_031.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Seki altepetlakamej uan topilmej kitookaskej akin omomikili. Katej itlanpa se kuauitl uan ik uejka kajki se tepetl ika se ojtli itlajkotia."}
{"id": "nlv_032", "filename": "images/nlv_032.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se topiltsi okiski omototonito ipan se tetl."}
{"id": "nlv_033", "filename": "images/nlv_033.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se ateskatl inauak se kali. Kiyaualojtok kuajyo."}
{"id": "nlv_034", "filename": "images/nlv_034.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Ateskatl ika ateskilitl inauak kuajyo."}
{"id": "nlv_035", "filename": "images/nlv_035.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se siuatsintli ika itlaken xochijyo itlanpa se aueuetl uejkapantik."}
{"id": "nlv_036", "filename": "images/nlv_036.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Serakilitl, xokok uan uelik ika se tlaxkali."}
{"id": "nlv_037", "filename": "images/nlv_037.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Xiuitl non kiluiaj \"kajkauapajtli\" uan tlapaleuia ijkuak ikaj aminajtok."}
{"id": "nlv_038", "filename": "images/nlv_038.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Seki soyonkej chilmej."}
{"id": "nlv_039", "filename": "images/nlv_039.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se gladiolajtooktli inauak se mila. Ik uejka tepeyo uan tlamixtentok."}
{"id": "nlv_040", "filename": "images/nlv_040.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se mamayotsintli kinextia yankuik xiuitl."}
{"id": "nlv_041", "filename": "images/nlv_041.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se kouatl non kiliaj \"palanka\"."}
{"id": "nlv_042", "filename": "images/nlv_042.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Miakej kalmej ipan tepetl."}
{"id": "nlv_043", "filename": "images/nlv_043.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se mantis ipan tlali."}
{"id": "nlv_044", "filename": "images/nlv_044.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se tlakatsin non otekipanoto mokopa icha ijkuak yitlayoua ik tepetl."}
{"id": "nlv_045", "filename": "images/nlv_045.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Seki buganbiliajxochitl."}
{"id": "nlv_046", "filename": "images/nlv_046.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se tokatsin ipan se omikilitl."}
{"id": "nlv_047", "filename": "images/nlv_047.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se pitsauaxochitl non yopejki pitsuaki."}
{"id": "nlv_048", "filename": "images/nlv_048.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se xochitl tlen kiluiaj \"pitsauaxochitl\"."}
{"id": "nlv_049", "filename": "images/nlv_049.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se ojtli tlen tlakoloua uan katej seki kalmej uan olochkuauitl tlen okintepankej."}
{"id": "nlv_050", "filename": "images/nlv_050.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Miak olochkuauitl okintepankej inauak se tepankali.."}
{"id": "nlv_051", "filename": "images/nlv_051.jpg", "split": "dev", "culture": "Nahua", "language": "Nahuatl Central", "iso_lang": "nlv", "target_caption": "Se tenantsin ika ialtepetlaken kichixtok karro kaltentli, ojtenpa."}
